#
# Kbuild fragment generated by CMake.  Do not edit the copy in the build tree.
#
# The portable core is C++20 but has no runtime dependencies: exceptions, RTTI,
# thread-safe statics, static constructors/destructors and unwind tables are
# disabled, and no standard library header is included.  Kbuild normally
# compiles C only, so the core objects get an explicit rule with the kernel
# flags plus the C++ settings.

obj-m := yt8531c.o
yt8531c-y := @YT8531C_KMOD_OBJS@
targets += @YT8531C_KMOD_TARGETS@

ccflags-y += -I@YT8531C_INCLUDE_DIR@ -I@YT8531C_CORE_DIR@ -Wno-undef

CXX_FLAGS_kmod = $(filter-out -std=gnu11 \
	-Werror=implicit-function-declaration -Werror=implicit-int \
	-Werror=strict-prototypes -Werror=incompatible-pointer-types \
	-Werror=designated-init -Wmissing-prototypes -Wno-pointer-sign \
	-Wno-override-init,$(c_flags)) \
	-std=gnu++20 -fno-exceptions -fno-rtti -fno-threadsafe-statics \
	-fno-use-cxa-atexit -fno-unwind-tables -fno-asynchronous-unwind-tables

$(obj)/yt8531c_phylib.o: @YT8531C_PHYLIB_SRC@ FORCE
	$(call if_changed_dep,cc_o_c)

quiet_cmd_cc_o_cpp = CXX [M] $@
      cmd_cc_o_cpp = $(CC) $(CXX_FLAGS_kmod) -c -o $@ $<

@YT8531C_KMOD_RULES@
